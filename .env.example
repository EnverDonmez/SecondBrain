# Core never contacts paid cloud providers. Values are examples, not credentials.
SB_DATA_DIR=data
SB_PORT=8765
SB_MEMORY_MODE=economy
# Default MCP exposes only prepare_context, remember, navigate and read.
# SB_MCP_PROFILE=full opts into legacy/admin tools; permissions still apply.
# Set SB_MEMORY_MODE=semantic only to opt into automatic local embedding jobs.
# SB_TOKEN=<restricted model token, never data/owner.token>
# SB_TOKEN_FILE=C:\path\to\SecondBrain\data\connections\codex\client.token
# SB_AUTOSTART=1 requires an absolute SB_DATA_DIR; starts only the matching local brain.
SB_SEMANTIC_IDLE_SECONDS=30
# SB_MODEL_DIR=C:\path\to\SecondBrain\data\models
# SB_OLLAMA_MODEL=<installed local model name>
HF_HUB_DISABLE_TELEMETRY=1
MEM0_TELEMETRY=false

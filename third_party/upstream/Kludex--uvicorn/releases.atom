  <entry>
    <id>tag:github.com,2008:Repository/92946971/0.50.2</id>
    <updated>2026-07-06T10:06:18Z</updated>
    <link rel="alternate" type="text/html" href="https://github.com/Kludex/uvicorn/releases/tag/0.50.2"/>
    <title>Version 0.50.2</title>

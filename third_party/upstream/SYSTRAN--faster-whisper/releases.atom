&lt;li&gt;Brings back original VAD parameters naming by &lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/Purfview/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/Purfview&quot;&gt;@Purfview&lt;/a&gt; in &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;2704050375&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/SYSTRAN/faster-whisper/issues/1181&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/SYSTRAN/faster-whisper/pull/1181/hovercard&quot; href=&quot;https://github.com/SYSTRAN/faster-whisper/pull/1181&quot;&gt;#1181&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Make batched &lt;code&gt;suppress_tokens&lt;/code&gt; behaviour same as in sequential by &lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/Purfview/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/Purfview&quot;&gt;@Purfview&lt;/a&gt; in &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;2726502378&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/SYSTRAN/faster-whisper/issues/1194&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/SYSTRAN/faster-whisper/pull/1194/hovercard&quot; href=&quot;https://github.com/SYSTRAN/faster-whisper/pull/1194&quot;&gt;#1194&lt;/a&gt;&lt;/li&gt;
